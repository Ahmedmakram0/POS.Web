@model POS.Web.ViewModels.SearchFilterFormModel

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@Model.SearchPlaceholder" />
    </div>
    <div class="col-md-3 form-check d-flex align-items-center">
        <input type="checkbox" name="includeInactive" value="true" class="form-check-input me-2" id="includeInactive" checked="@Model.IncludeInactive" />
        <label class="form-check-label" for="includeInactive">شامل غير النشط</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">بحث</button>
    </div>
</form>
