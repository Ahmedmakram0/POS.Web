@using POS.Web.Authorization
@inject Microsoft.AspNetCore.Identity.SignInManager<POS.Web.Models.Identity.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<POS.Web.Models.Identity.ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string ActiveIf(params string[] controllers) => controllers.Contains(currentController) ? "active" : "";

    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Admin");
    List<string> allowedPages = [];
    if (SignInManager.IsSignedIn(User) && !isAdmin)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        allowedPages = PageAccess.Parse(currentUser?.AllowedPages);
    }
    bool CanOpen(string controller) => isAdmin || allowedPages.Contains(controller);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - نظام نقاط البيع</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop"></i> نظام نقاط البيع
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            @if (CanOpen("Pos"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @ActiveIf("Pos")" asp-controller="Pos" asp-action="Index">
                                        <i class="bi bi-cart-check-fill"></i> نقطة البيع
                                    </a>
                                </li>
                            }
                            @if (CanOpen("Sales"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @ActiveIf("Sales")" asp-controller="Sales" asp-action="Index">
                                        <i class="bi bi-receipt"></i> المبيعات
                                    </a>
                                </li>
                            }
                            @if (CanOpen("Products") || CanOpen("Categories") || CanOpen("Stores"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @ActiveIf("Products", "Categories", "Stores")" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-box-seam"></i> المخزون
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (CanOpen("Products"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Products" asp-action="Index"><i class="bi bi-box me-1"></i> المنتجات</a></li>
                                        }
                                        @if (CanOpen("Categories"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-1"></i> الفئات</a></li>
                                        }
                                        @if (CanOpen("Stores"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Stores" asp-action="Index"><i class="bi bi-shop-window me-1"></i> الفروع</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (CanOpen("Customers") || CanOpen("Suppliers") || CanOpen("Purchases"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @ActiveIf("Customers", "Suppliers", "Purchases")" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-people"></i> الشركاء
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (CanOpen("Customers"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index"><i class="bi bi-person me-1"></i> العملاء</a></li>
                                        }
                                        @if (CanOpen("Suppliers"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck me-1"></i> الموردين</a></li>
                                        }
                                        @if (CanOpen("Purchases"))
                                        {
                                            <li><a class="dropdown-item" asp-controller="Purchases" asp-action="Index"><i class="bi bi-bag-plus me-1"></i> المشتريات</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (CanOpen("Safe"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @ActiveIf("Safe")" asp-controller="Safe" asp-action="Index">
                                        <i class="bi bi-safe2"></i> الخزينة
                                    </a>
                                </li>
                            }
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @ActiveIf("Users", "Settings")" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear"></i> الإدارة
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge me-1"></i> المستخدمون</a></li>
                                        <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders me-1"></i> الإعدادات</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            @if (isAdmin)
                            {
                                @await Component.InvokeAsync("StockAlerts")
                            }
                            <li class="nav-item d-flex align-items-center text-light opacity-75 me-lg-3 mb-2 mb-lg-0">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity!.Name
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid py-4">
        @if (TempData["Success"] is not null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
        }
        @if (TempData["Error"] is not null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-center py-3">
        &copy; @DateTime.Now.Year - نظام نقاط البيع
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
