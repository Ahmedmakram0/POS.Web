@using POS.Web.Services.Customers
@model List<CustomerListItemDto>
@{
    ViewData["Title"] = "العملاء";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>العملاء</h2>
    <a class="btn btn-primary" asp-action="Create">إضافة عميل</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="بحث بالاسم أو الهاتف..." />
    </div>
    <div class="col-md-3 form-check d-flex align-items-center">
        <input type="checkbox" name="includeInactive" value="true" class="form-check-input me-2" id="includeInactive" checked="@((bool)ViewData["IncludeInactive"]!)" />
        <label class="form-check-label" for="includeInactive">شامل غير النشط</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">بحث</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                <td>@customer.Phone</td>
                <td>
                    @if (customer.Status == EntityStatus.Active)
                    {
                        <span class="badge text-bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">غير نشط</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@customer.Id">تعديل</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
