@model Customer
@{
    ViewData["Title"] = Model.Name;
    var balance = (decimal)ViewData["Balance"]!;
    var history = (List<CustomerCreditTransaction>)ViewData["History"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">تعديل</a>
        <a class="btn btn-success" asp-action="RecordPayment" asp-route-id="@Model.Id">تسجيل دفعة</a>
        <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
            <input type="hidden" name="currentStatus" value="@Model.Status" />
            <button type="submit" class="btn btn-outline-secondary">
                @(Model.Status == EntityStatus.Active ? "تعطيل" : "تفعيل")
            </button>
        </form>
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body"><div class="text-muted small">الهاتف</div><div class="fs-5">@Model.Phone</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card @(balance > 0 ? "text-bg-warning" : "") h-100"><div class="card-body"><div class="text-muted small">الرصيد الحالي (آجل)</div><div class="fs-5 fw-bold">@balance.ToString("N2")</div></div></div>
    </div>
</div>

<h4 class="mb-3">سجل الحركات الآجلة</h4>
<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>النوع</th>
            <th>المبلغ</th>
            <th>الرصيد بعد الحركة</th>
            <th>البيع المرتبط</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in history)
        {
            <tr>
                <td>@t.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@(t.Type == CustomerCreditTransactionType.CreditSale ? "بيع آجل" : "دفعة")</td>
                <td>@t.Amount.ToString("N2")</td>
                <td>@t.BalanceAfter.ToString("N2")</td>
                <td>@(t.SaleId is not null ? $"فاتورة #{t.SaleId}" : "")</td>
            </tr>
        }
    </tbody>
</table>
</div>
