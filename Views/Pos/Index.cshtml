@{
    ViewData["Title"] = "نقطة البيع";
    var customers = (List<Customer>)ViewData["Customers"]!;
}

@Html.AntiForgeryToken()

<div class="row g-3">
    <div class="col-md-7">
        <div class="input-group mb-1">
            <span class="input-group-text">🔍</span>
            <input type="text" id="searchBox" class="form-control form-control-lg" placeholder="ابحث بالاسم أو امسح الباركود..." autofocus autocomplete="off" />
        </div>
        <div id="scanFeedback" class="small mb-2"></div>
        <div id="searchResults" class="list-group mb-3"></div>

        <div class="table-responsive">
<table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>المنتج</th>
                    <th>الكمية</th>
                    <th>السعر</th>
                    <th>الحد الأدنى</th>
                    <th>الخصم</th>
                    <th>الإجمالي</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cartBody"></tbody>
        </table>
</div>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">العميل</label>
                    <select id="customerSelect" class="form-select">
                        <option value="">عميل نقدي (بدون بيع آجل)</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="table-responsive">
<table class="table">
                    <tr><td>الإجمالي الفرعي</td><td class="text-end" id="subtotalDisplay">0.00</td></tr>
                    <tr><td>الخصم</td><td class="text-end" id="discountDisplay">0.00</td></tr>
                    <tr class="fs-5 fw-bold"><td>الإجمالي</td><td class="text-end" id="totalDisplay">0.00</td></tr>
                </table>
</div>

                <h6 class="mt-3">الدفع</h6>
                <div id="paymentsBody"></div>
                <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addPaymentBtn">+ إضافة طريقة دفع</button>

                <div class="d-flex justify-content-between">
                    <span>المتبقي للدفع</span>
                    <strong id="remainingDisplay">0.00</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>الباقي للعميل</span>
                    <strong id="changeDisplay">0.00</strong>
                </div>

                <div id="checkoutError" class="alert alert-danger d-none"></div>

                <button type="button" class="btn btn-primary btn-lg w-100" id="checkoutBtn">إتمام البيع</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
    let cart = [];
    let payments = [{ method: 'Cash', amount: 0 }];

    const searchBox = document.getElementById('searchBox');
    const searchResults = document.getElementById('searchResults');
    const scanFeedback = document.getElementById('scanFeedback');
    const cartBody = document.getElementById('cartBody');
    const paymentsBody = document.getElementById('paymentsBody');

    function flashScanFeedback(message, isError) {
        scanFeedback.textContent = message;
        scanFeedback.className = 'small mb-2 ' + (isError ? 'text-danger' : 'text-success');
        setTimeout(() => { scanFeedback.textContent = ''; }, 2500);
    }

    let searchTimer;
    searchBox.addEventListener('input', () => {
        clearTimeout(searchTimer);
        const q = searchBox.value.trim();
        if (!q) { searchResults.innerHTML = ''; return; }
        searchTimer = setTimeout(async () => {
            const res = await fetch(`/Pos/SearchProducts?q=${encodeURIComponent(q)}`);
            const products = await res.json();
            searchResults.innerHTML = products.map(p => {
                const locationLabel = [p.store, p.location].filter(Boolean).join(' — ');
                const thumb = p.imageUrl
                    ? `<img src="${p.imageUrl}" alt="" style="width:36px;height:36px;object-fit:cover;" class="rounded border me-2" />`
                    : `<span class="rounded border bg-light d-inline-block me-2" style="width:36px;height:36px;"></span>`;
                return `
                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center search-item"
                    data-id="${p.id}" data-name="${p.name.replace(/"/g,'&quot;')}" data-price="${p.price}" data-minprice="${p.minPrice}" data-stock="${p.stock}" data-imageurl="${p.imageUrl || ''}">
                    <span class="d-flex align-items-center">
                        ${thumb}
                        <span>
                            ${p.name} <small class="text-muted">(${p.barcode})</small>
                            ${locationLabel ? `<br><small class="text-primary">📍 ${locationLabel}</small>` : ''}
                        </span>
                    </span>
                    <span>${p.price.toFixed(2)} <small class="text-muted">(الحد الأدنى: ${p.minPrice.toFixed(2)})</small> — مخزون: ${p.stock}</span>
                </button>`;
            }).join('') || '<div class="list-group-item text-muted">لا توجد نتائج</div>';

            searchResults.querySelectorAll('.search-item').forEach(btn => {
                btn.addEventListener('click', () => {
                    addToCart({
                        productId: parseInt(btn.dataset.id),
                        name: btn.dataset.name,
                        unitPrice: parseFloat(btn.dataset.price),
                        minPrice: parseFloat(btn.dataset.minprice),
                        imageUrl: btn.dataset.imageurl || null,
                        quantity: 1,
                        discountType: '',
                        discountValue: 0,
                    });
                    searchBox.value = '';
                    searchResults.innerHTML = '';
                    searchBox.focus();
                });
            });
        }, 250);
    });

    // Barcode scanners act as a very fast keyboard: characters land in whatever has focus,
    // followed by Enter. The search box has autofocus, so Enter there is the primary path.
    searchBox.addEventListener('keydown', e => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const value = searchBox.value.trim();
        if (value) {
            addByBarcode(value);
        }
    });

    // Fallback: if focus lands elsewhere on the page (not an editable field), still catch scans.
    let scanBuffer = '';
    let lastScanCharTime = 0;
    document.addEventListener('keydown', e => {
        const active = document.activeElement;
        const isEditableElsewhere = active && active !== searchBox &&
            (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT');
        if (isEditableElsewhere) { scanBuffer = ''; return; }
        if (active === searchBox) { scanBuffer = ''; return; }

        const now = Date.now();
        if (e.key === 'Enter') {
            if (scanBuffer.length >= 3) {
                e.preventDefault();
                addByBarcode(scanBuffer);
            }
            scanBuffer = '';
            return;
        }
        if (e.key.length === 1) {
            if (now - lastScanCharTime > 75) { scanBuffer = ''; }
            scanBuffer += e.key;
            lastScanCharTime = now;
        }
    });

    async function addByBarcode(barcode) {
        try {
            const res = await fetch(`/Pos/LookupByBarcode?barcode=${encodeURIComponent(barcode)}`);
            if (!res.ok) {
                flashScanFeedback(`لا يوجد منتج بالباركود: ${barcode}`, true);
                return;
            }
            const p = await res.json();
            addToCart({
                productId: p.id, name: p.name, unitPrice: p.price, minPrice: p.minPrice, imageUrl: p.imageUrl || null,
                quantity: 1, discountType: '', discountValue: 0,
            });
            flashScanFeedback(`تمت إضافة: ${p.name}`, false);
        } catch {
            flashScanFeedback('تعذر الاتصال بالخادم.', true);
        } finally {
            searchBox.value = '';
            searchResults.innerHTML = '';
            searchBox.focus();
        }
    }

    function addToCart(line) {
        const existing = cart.find(c => c.productId === line.productId && !c.discountType);
        if (existing) { existing.quantity += 1; } else { cart.push(line); }
        renderCart();
    }

    function computeFinalPrice(line) {
        let final = line.unitPrice;
        if (line.discountType === 'FixedAmount') final = line.unitPrice - line.discountValue;
        else if (line.discountType === 'Percentage') final = line.unitPrice * (1 - line.discountValue / 100);
        else if (line.discountType === 'FinalUnitPrice') final = line.discountValue;
        return Math.max(0, final);
    }

    function renderCart() {
        cartBody.innerHTML = cart.map((line, i) => {
            const finalPrice = computeFinalPrice(line);
            const lineTotal = finalPrice * line.quantity;
            const belowMin = finalPrice < line.minPrice;
            const thumb = line.imageUrl
                ? `<img src="${line.imageUrl}" alt="" style="width:32px;height:32px;object-fit:cover;" class="rounded border" />`
                : '';
            return `
            <tr class="${belowMin ? 'table-danger' : ''}">
                <td>${thumb}</td>
                <td>${line.name}</td>
                <td><input type="number" min="1" value="${line.quantity}" class="form-control form-control-sm cart-qty" data-i="${i}" style="width:70px" /></td>
                <td>${line.unitPrice.toFixed(2)}</td>
                <td class="text-muted">${line.minPrice.toFixed(2)}</td>
                <td>
                    <select class="form-select form-select-sm cart-disc-type" data-i="${i}" style="width:110px">
                        <option value="" ${!line.discountType ? 'selected' : ''}>بدون خصم</option>
                        <option value="FixedAmount" ${line.discountType==='FixedAmount'?'selected':''}>مبلغ ثابت</option>
                        <option value="Percentage" ${line.discountType==='Percentage'?'selected':''}>نسبة %</option>
                        <option value="FinalUnitPrice" ${line.discountType==='FinalUnitPrice'?'selected':''}>سعر نهائي</option>
                    </select>
                    ${line.discountType ? `<input type="number" step="0.01" value="${line.discountValue}" class="form-control form-control-sm cart-disc-value mt-1" data-i="${i}" style="width:110px" />` : ''}
                    ${belowMin ? '<div class="text-danger small mt-1">أقل من الحد الأدنى!</div>' : ''}
                </td>
                <td>${lineTotal.toFixed(2)}</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger cart-remove" data-i="${i}">حذف</button></td>
            </tr>`;
        }).join('');

        cartBody.querySelectorAll('.cart-qty').forEach(el => el.addEventListener('input', e => {
            cart[e.target.dataset.i].quantity = Math.max(1, parseInt(e.target.value) || 1);
            recalcTotals();
        }));
        cartBody.querySelectorAll('.cart-disc-type').forEach(el => el.addEventListener('change', e => {
            cart[e.target.dataset.i].discountType = e.target.value;
            cart[e.target.dataset.i].discountValue = 0;
            renderCart();
        }));
        cartBody.querySelectorAll('.cart-disc-value').forEach(el => {
            el.addEventListener('input', e => {
                cart[e.target.dataset.i].discountValue = parseFloat(e.target.value) || 0;
                recalcTotals();
            });
            el.addEventListener('change', e => {
                const line = cart[e.target.dataset.i];
                if (computeFinalPrice(line) < line.minPrice) {
                    alert(`تنبيه: السعر بعد الخصم لصنف "${line.name}" أقل من الحد الأدنى لسعر البيع (${line.minPrice.toFixed(2)}).`);
                }
                renderCart();
            });
        });
        cartBody.querySelectorAll('.cart-remove').forEach(el => el.addEventListener('click', e => {
            cart.splice(parseInt(e.target.dataset.i), 1);
            renderCart();
        }));

        recalcTotals();
    }

    function renderPayments() {
        paymentsBody.innerHTML = payments.map((p, i) => `
            <div class="input-group input-group-sm mb-2">
                <select class="form-select payment-method" data-i="${i}">
                    <option value="Cash" ${p.method==='Cash'?'selected':''}>نقدي</option>
                    <option value="InstaPay" ${p.method==='InstaPay'?'selected':''}>إنستاباي</option>
                    <option value="VodafoneCash" ${p.method==='VodafoneCash'?'selected':''}>فودافون كاش</option>
                    <option value="Credit" ${p.method==='Credit'?'selected':''}>آجل</option>
                </select>
                <input type="number" step="0.01" class="form-control payment-amount" data-i="${i}" value="${p.amount}" />
                ${payments.length > 1 ? `<button type="button" class="btn btn-outline-danger payment-remove" data-i="${i}">×</button>` : ''}
            </div>`).join('');

        paymentsBody.querySelectorAll('.payment-method').forEach(el => el.addEventListener('change', e => {
            payments[e.target.dataset.i].method = e.target.value;
            recalcTotals();
        }));
        paymentsBody.querySelectorAll('.payment-amount').forEach(el => el.addEventListener('input', e => {
            payments[e.target.dataset.i].amount = parseFloat(e.target.value) || 0;
            recalcTotals();
        }));
        paymentsBody.querySelectorAll('.payment-remove').forEach(el => el.addEventListener('click', e => {
            payments.splice(parseInt(e.target.dataset.i), 1);
            renderPayments();
        }));
    }

    document.getElementById('addPaymentBtn').addEventListener('click', () => {
        payments.push({ method: 'Cash', amount: 0 });
        renderPayments();
    });

    function recalcTotals() {
        let subtotal = 0, total = 0;
        cart.forEach(line => {
            const finalPrice = computeFinalPrice(line);
            subtotal += line.unitPrice * line.quantity;
            total += finalPrice * line.quantity;
        });
        const discount = subtotal - total;

        document.getElementById('subtotalDisplay').textContent = subtotal.toFixed(2);
        document.getElementById('discountDisplay').textContent = discount.toFixed(2);
        document.getElementById('totalDisplay').textContent = total.toFixed(2);

        const totalPaid = payments.reduce((s, p) => s + (p.amount || 0), 0);
        const nonCredit = payments.filter(p => p.method !== 'Credit').reduce((s, p) => s + (p.amount || 0), 0);
        const credit = payments.filter(p => p.method === 'Credit').reduce((s, p) => s + (p.amount || 0), 0);
        const dueAfterCredit = total - credit;
        const remaining = Math.max(0, dueAfterCredit - nonCredit);
        const change = Math.max(0, nonCredit - dueAfterCredit);

        document.getElementById('remainingDisplay').textContent = remaining.toFixed(2);
        document.getElementById('changeDisplay').textContent = change.toFixed(2);
    }

    document.getElementById('checkoutBtn').addEventListener('click', async () => {
        const errorBox = document.getElementById('checkoutError');
        errorBox.classList.add('d-none');

        if (cart.length === 0) {
            errorBox.textContent = 'أضف صنفاً واحداً على الأقل.';
            errorBox.classList.remove('d-none');
            return;
        }

        const belowMinLine = cart.find(l => computeFinalPrice(l) < l.minPrice);
        if (belowMinLine && !confirm(`صنف "${belowMinLine.name}" بسعر أقل من الحد الأدنى. هل تريد المتابعة؟`)) {
            return;
        }

        const customerId = document.getElementById('customerSelect').value || null;
        const payload = {
            customerId: customerId ? parseInt(customerId) : null,
            items: cart.map(l => ({
                productId: l.productId,
                quantity: l.quantity,
                discountType: l.discountType || null,
                discountValue: l.discountValue || 0,
            })),
            payments: payments.filter(p => p.amount > 0).map(p => ({ method: p.method, amount: p.amount })),
        };

        const res = await fetch('/Pos/Checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': antiforgeryToken },
            body: JSON.stringify(payload),
        });

        if (res.ok) {
            const data = await res.json();
            window.open(`/Sales/Receipt/${data.saleId}`, '_blank');
            window.location.href = `/Sales/Details/${data.saleId}`;
        } else {
            const data = await res.json().catch(() => ({ message: 'حدث خطأ غير متوقع.' }));
            errorBox.textContent = data.message || 'حدث خطأ غير متوقع.';
            errorBox.classList.remove('d-none');
        }
    });

    renderPayments();
    renderCart();
</script>
}
