@model List<Store>
@{
    ViewData["Title"] = "الفروع";
    var includeInactive = (bool)ViewData["IncludeInactive"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الفروع</h2>
    <a class="btn btn-primary" asp-action="Create">إضافة فرع</a>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="includeInactive" onchange="location.href='@Url.Action("Index")?includeInactive=' + this.checked" @(includeInactive ? "checked" : "") />
    <label class="form-check-label" for="includeInactive">عرض الفروع غير النشطة</label>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>العنوان</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th>عدد المنتجات</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var store in Model)
        {
            <tr>
                <td>@store.Name</td>
                <td>@store.Address</td>
                <td>@store.Phone</td>
                <td>
                    @if (store.Status == EntityStatus.Active)
                    {
                        <span class="badge text-bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">غير نشط</span>
                    }
                </td>
                <td>@store.Products.Count</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@store.Id">تعديل</a>
                    <form asp-action="ToggleStatus" asp-route-id="@store.Id" method="post" class="d-inline">
                        <input type="hidden" name="currentStatus" value="@store.Status" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(store.Status == EntityStatus.Active ? "تعطيل" : "تفعيل")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
