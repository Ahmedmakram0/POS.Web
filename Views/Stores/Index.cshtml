@using POS.Web.Services.Catalog
@model List<StoreListItemDto>
@{
    ViewData["Title"] = "الفروع";
    var includeInactive = (bool)ViewData["IncludeInactive"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الفروع</h2>
    <a class="btn btn-primary" asp-action="Create">إضافة فرع</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3 form-check d-flex align-items-center">
        <input type="checkbox" name="includeInactive" value="true" class="form-check-input me-2" id="includeInactive" checked="@includeInactive" />
        <label class="form-check-label" for="includeInactive">عرض الفروع غير النشطة</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">بحث</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>العنوان</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th>عدد المنتجات</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var store in Model)
        {
            <tr>
                <td>@store.Name</td>
                <td>@store.Address</td>
                <td>@store.Phone</td>
                <td>
                    @if (store.Status == EntityStatus.Active)
                    {
                        <span class="badge text-bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">غير نشط</span>
                    }
                </td>
                <td>@store.ProductCount</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@store.Id">تعديل</a>
                    <partial name="_ToggleStatusButton" model="new ToggleStatusButtonModel(store.Id, store.Status)" />
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
