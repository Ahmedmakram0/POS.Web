@model PurchaseInvoice
@{
    ViewData["Title"] = Model.InvoiceNumber;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>فاتورة شراء @Model.InvoiceNumber</h2>
        @if (!string.IsNullOrWhiteSpace(Model.SupplierInvoiceReference))
        {
            <div class="text-muted">رقم فاتورة المورد: @Model.SupplierInvoiceReference</div>
        }
    </div>
    <div>
        @if (Model.OutstandingAmount > 0)
        {
            <a class="btn btn-success" asp-action="AddPayment" asp-route-id="@Model.Id">تسجيل دفعة</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">رجوع للمورد</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body"><div class="text-muted small">المورد</div><div class="fs-5">@Model.Supplier?.Name</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body"><div class="text-muted small">الإجمالي</div><div class="fs-5">@Model.Total.ToString("N2")</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body"><div class="text-muted small">المدفوع</div><div class="fs-5">@Model.AmountPaid.ToString("N2")</div></div></div>
    </div>
    <div class="col-md-3">
        <div class="card @(Model.OutstandingAmount > 0 ? "text-bg-warning" : "") h-100"><div class="card-body"><div class="text-muted small">المتبقي</div><div class="fs-5 fw-bold">@Model.OutstandingAmount.ToString("N2")</div></div></div>
    </div>
</div>

<h5 class="mb-3">الأصناف</h5>
<div class="table-responsive">
<table class="table table-striped mb-4">
    <thead><tr><th>المنتج</th><th>الكمية</th><th>سعر الوحدة</th><th>الإجمالي</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitCostPrice.ToString("N2")</td>
                <td>@item.LineTotal.ToString("N2")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-dark" asp-controller="Products" asp-action="PrintLabels" asp-route-id="@item.ProductId" target="_blank" title="طباعة ملصق الباركود">
                        <i class="bi bi-printer"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<h5 class="mb-3">الدفعات</h5>
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th>التاريخ</th><th>المبلغ</th><th>الطريقة</th></tr></thead>
    <tbody>
        @foreach (var payment in Model.Payments)
        {
            <tr>
                <td>@payment.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@payment.Amount.ToString("N2")</td>
                <td>@payment.Method</td>
            </tr>
        }
    </tbody>
</table>
</div>
