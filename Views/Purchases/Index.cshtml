@model List<PurchaseInvoice>
@{
    ViewData["Title"] = "فواتير الشراء";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>فواتير الشراء</h2>
    <a class="btn btn-primary" asp-action="Create">فاتورة شراء جديدة</a>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>رقم الفاتورة</th>
            <th>رقم فاتورة المورد</th>
            <th>المورد</th>
            <th>التاريخ</th>
            <th>الإجمالي</th>
            <th>المتبقي</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Model)
        {
            <tr>
                <td>@invoice.InvoiceNumber</td>
                <td>@invoice.SupplierInvoiceReference</td>
                <td>@invoice.Supplier?.Name</td>
                <td>@invoice.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@invoice.Total.ToString("N2")</td>
                <td>@invoice.OutstandingAmount.ToString("N2")</td>
                <td>@invoice.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@invoice.Id">عرض</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
