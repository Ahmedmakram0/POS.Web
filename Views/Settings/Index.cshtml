@model POS.Web.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "الإعدادات";
}

<h2 class="mb-4">الإعدادات</h2>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">إعدادات المتجر</div>
            <div class="card-body">
                <form asp-action="SaveSystem" method="post">
                    <input type="hidden" name="Id" value="@Model.System.Id" />
                    <div class="mb-3">
                        <label class="form-label">اسم المتجر</label>
                        <input name="StoreName" class="form-control" value="@Model.System.StoreName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العنوان</label>
                        <input name="StoreAddress" class="form-control" value="@Model.System.StoreAddress" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الهاتف</label>
                        <input name="StorePhone" class="form-control" value="@Model.System.StorePhone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العملة</label>
                        <input name="Currency" class="form-control" value="@Model.System.Currency" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حد التنبيه لانخفاض المخزون (افتراضي)</label>
                        <input name="DefaultLowStockThreshold" type="number" class="form-control" value="@Model.System.DefaultLowStockThreshold" />
                    </div>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">إعدادات الفاتورة (الطباعة)</div>
            <div class="card-body">
                <form asp-action="SaveReceipt" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="@Model.Receipt.Id" />
                    <div class="mb-3">
                        <label class="form-label">شعار المتجر</label>
                        @if (!string.IsNullOrWhiteSpace(Model.Receipt.LogoUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.Receipt.LogoUrl" alt="الشعار الحالي" style="max-height:80px;max-width:100%;" />
                            </div>
                        }
                        <input type="file" name="logoFile" class="form-control" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                        <div class="form-text">يتم رفع الشعار مرة واحدة ويُستخدم تلقائياً في كل الفواتير المطبوعة.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">عنوان الفاتورة</label>
                        <input name="ReceiptTitle" class="form-control" value="@Model.Receipt.ReceiptTitle" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">بيانات ضريبية</label>
                        <input name="TaxInfo" class="form-control" value="@Model.Receipt.TaxInfo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">رسالة الختام</label>
                        <input name="FooterMessage" class="form-control" value="@Model.Receipt.FooterMessage" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">عرض الفاتورة (مم)</label>
                        <select name="ReceiptWidthMm" class="form-select">
                            <option value="80" selected="@(Model.Receipt.ReceiptWidthMm == 80)">80 مم</option>
                            <option value="58" selected="@(Model.Receipt.ReceiptWidthMm == 58)">58 مم</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">إعدادات الخصومات</div>
            <div class="card-body">
                <form asp-action="SaveDiscount" method="post">
                    <input type="hidden" name="Id" value="@Model.Discount.Id" />
                    <div class="mb-3">
                        <label class="form-label">الحد الأقصى الافتراضي لخصم الكاشير (%)</label>
                        <input name="DefaultCashierMaxDiscountPercent" type="number" step="0.1" class="form-control" value="@Model.Discount.DefaultCashierMaxDiscountPercent" />
                    </div>
                    <div class="form-check mb-3">
                        <input name="RequireManagerApprovalAboveLimit" type="checkbox" value="true" class="form-check-input" checked="@Model.Discount.RequireManagerApprovalAboveLimit" />
                        <input type="hidden" name="RequireManagerApprovalAboveLimit" value="false" />
                        <label class="form-check-label">يتطلب موافقة المدير عند تجاوز الحد</label>
                    </div>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </form>
            </div>
        </div>
    </div>
</div>
