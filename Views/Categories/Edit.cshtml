@model POS.Web.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "تعديل فئة";
}

<h2 class="mb-4">تعديل فئة</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
