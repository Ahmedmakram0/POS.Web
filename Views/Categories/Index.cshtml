@using POS.Web.Services.Catalog
@model List<CategoryListItemDto>
@{
    ViewData["Title"] = "الفئات";
    var includeInactive = (bool)ViewData["IncludeInactive"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الفئات</h2>
    <a class="btn btn-primary" asp-action="Create">إضافة فئة</a>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="includeInactive" onchange="location.href='@Url.Action("Index")?includeInactive=' + this.checked" @(includeInactive ? "checked" : "") />
    <label class="form-check-label" for="includeInactive">عرض الفئات غير النشطة</label>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الحالة</th>
            <th>عدد المنتجات</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    @if (category.Status == EntityStatus.Active)
                    {
                        <span class="badge text-bg-success">نشطة</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">غير نشطة</span>
                    }
                </td>
                <td>@category.ProductCount</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">تعديل</a>
                    <form asp-action="ToggleStatus" asp-route-id="@category.Id" method="post" class="d-inline">
                        <input type="hidden" name="currentStatus" value="@category.Status" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(category.Status == EntityStatus.Active ? "تعطيل" : "تفعيل")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
