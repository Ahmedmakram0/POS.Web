@using POS.Web.Services.Purchasing
@model Supplier
@{
    ViewData["Title"] = Model.Name;
    var outstanding = (decimal)ViewData["OutstandingBalance"]!;
    var invoices = (List<PurchaseInvoiceListItemDto>)ViewData["Invoices"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Name</h2>
    <div>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">تعديل</a>
        <a class="btn btn-success" asp-controller="Purchases" asp-action="Create" asp-route-supplierId="@Model.Id">فاتورة شراء جديدة</a>
        <partial name="_ToggleStatusButton" model='new ToggleStatusButtonModel(Model.Id, Model.Status, "btn btn-outline-secondary")' />
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body"><div class="text-muted small">الهاتف</div><div class="fs-5">@Model.Phone</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card @(outstanding > 0 ? "text-bg-warning" : "") h-100"><div class="card-body"><div class="text-muted small">الرصيد المستحق</div><div class="fs-5 fw-bold">@outstanding.ToString("N2")</div></div></div>
    </div>
</div>

<h4 class="mb-3">فواتير الشراء</h4>
<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>رقم الفاتورة</th>
            <th>التاريخ</th>
            <th>الإجمالي</th>
            <th>المدفوع</th>
            <th>المتبقي</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in invoices)
        {
            <tr>
                <td><a asp-controller="Purchases" asp-action="Details" asp-route-id="@invoice.Id">@invoice.InvoiceNumber</a></td>
                <td>@invoice.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@invoice.Total.ToString("N2")</td>
                <td>@invoice.AmountPaid.ToString("N2")</td>
                <td>@invoice.OutstandingAmount.ToString("N2")</td>
                <td>@invoice.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Purchases" asp-action="Details" asp-route-id="@invoice.Id">عرض</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
