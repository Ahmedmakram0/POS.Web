@using POS.Web.Services.Purchasing
@model List<SupplierListItemDto>
@{
    ViewData["Title"] = "الموردين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الموردين</h2>
    <a class="btn btn-primary" asp-action="Create">إضافة مورد</a>
</div>

<partial name="_SearchFilterForm" model='new SearchFilterFormModel((string?)ViewData["Search"], (bool)ViewData["IncludeInactive"]!, "بحث بالاسم أو الهاتف...")' />

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الهاتف</th>
            <th>الحالة</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@supplier.Id">@supplier.Name</a></td>
                <td>@supplier.Phone</td>
                <td>
                    @if (supplier.Status == EntityStatus.Active)
                    {
                        <span class="badge text-bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">غير نشط</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@supplier.Id">تعديل</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
