@model POS.Web.ViewModels.ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Barcode" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Barcode" class="form-control" id="barcodeInput" />
            <button type="button" class="btn btn-outline-secondary" id="generateBarcodeBtn">توليد</button>
        </div>
        <span asp-validation-for="Barcode" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SKU" class="form-label"></label>
        <input asp-for="SKU" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">اختر الفئة</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SupplierId" class="form-label"></label>
        <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.Suppliers, "Id", "Name"))">
            <option value="">بدون مورد</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="StoreId" class="form-label"></label>
        <select asp-for="StoreId" class="form-select" asp-items="@(new SelectList(Model.Stores, "Id", "Name"))">
            <option value="">بدون تحديد فرع</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="مثال: ممر 3 - رف ب" />
    </div>
    <div class="col-md-4">
        <label asp-for="MinimumStockLevel" class="form-label"></label>
        <input asp-for="MinimumStockLevel" class="form-control" type="number" />
    </div>
    <div class="col-md-4">
        <label asp-for="CostPrice" class="form-label"></label>
        <input asp-for="CostPrice" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="CostPrice" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SellingPrice" class="form-label"></label>
        <input asp-for="SellingPrice" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="SellingPrice" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MinimumSellingPrice" class="form-label"></label>
        <input asp-for="MinimumSellingPrice" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MinimumSellingPrice" class="text-danger"></span>
    </div>
    @if (Model.Id == 0)
    {
        <div class="col-md-4">
            <label asp-for="InitialStockQuantity" class="form-label"></label>
            <input asp-for="InitialStockQuantity" class="form-control" type="number" />
        </div>
    }
    <div class="col-md-4">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="mt-2">
                <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width:120px;max-height:120px;object-fit:cover;" class="rounded border" />
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary">حفظ</button>
    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
</div>

<script>
    document.getElementById('generateBarcodeBtn').addEventListener('click', async () => {
        const res = await fetch('@Url.Action("GenerateBarcode")');
        const data = await res.json();
        document.getElementById('barcodeInput').value = data.barcode;
    });
</script>
